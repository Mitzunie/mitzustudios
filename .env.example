# ─── Database (Prisma Postgres) ───
# Formato direct TCP: postgres://identifier:key@db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL=postgres://user:pass@host:5432/mitzustudios

# ─── Auth (Auth.js) ───
AUTH_SECRET=<32+ chars, genera con: openssl rand -base64 32>
ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com,admin3@gmail.com

# ─── Resend (Email) ───
RESEND_API_KEY=re_xxxxx
NOTIFICATION_EMAIL=mitzustudioscl@gmail.com

# ─── Cloudinary ───
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456
CLOUDINARY_API_SECRET=abc123

# ─── WhatsApp (wa.me) ───
WHATSAPP_PYME_NUMBER=56912345678

# ─── Google Analytics ───
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXX

# ─── Contact (Público) ───
NEXT_PUBLIC_CONTACT_EMAIL=mitzustudioscl@gmail.com

# ─── Rate Limiting ───
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# ─── Logo (opcional) ───
# URL pública del logo (Cloudinary, Imgur, etc.). Si no se setea, muestra "MitzuStudios" como texto.
NEXT_PUBLIC_SITE_LOGO_URL=

# ─── Vercel (opcional) ───
NEXT_PUBLIC_VERCEL_URL=mitzustudios.online
