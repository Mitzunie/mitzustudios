      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-background: #0a0a0f;\n    --color-foreground: #e8e0f0;\n    --color-card: #120e1a;\n    --color-primary: #7c3aed;\n    --color-accent: #6d28d9;\n    --color-secondary: #2d1b4e;\n    --color-muted: #1a1428;\n    --color-muted-foreground: #8a7a9e;\n    --color-border: #2d1b4e;\n    --color-neo-shadow: rgba(124, 58, 237, 0.3);\n  }\n\n  body {\n    background-color: var(--color-background);\n    color: var(--color-foreground);\n    font-family: 'Space Mono', monospace;\n    margin: 0;\n  }\n\n  .font-heading {\n    font-family: 'Space Grotesk', sans-serif;\n  }\n\n  .neo-border {\n    border: 3px solid var(--color-border);\n  }\n\n  .neo-shadow {\n    box-shadow: 6px 6px 0px 0px var(--color-neo-shadow);\n  }\n\n  .neo-shadow-lg {\n    box-shadow: 12px 12px 0px 0px var(--color-neo-shadow);\n  }\n\n  .neo-card {\n    background-color: var(--color-card);\n    border: 3px solid var(--color-border);\n    box-shadow: 8px 8px 0px 0px var(--color-neo-shadow);\n    transition: all 0.2s ease;\n  }\n\n  .neo-card:hover {\n    transform: translate(-4px, -4px);\n    box-shadow: 12px 12px 0px 0px var(--color-primary);\n  }\n\n  .neo-button-primary {\n    background-color: var(--color-primary);\n    color: white;\n    border: 3px solid var(--color-border);\n    font-weight: 800;\n    text-transform: uppercase;\n    padding: 1rem 2rem;\n    display: inline-block;\n    cursor: pointer;\n    transition: all 0.15s ease;\n  }\n\n  .neo-button-primary:hover {\n    transform: translate(-3px, -3px);\n    box-shadow: 6px 6px 0px 0px var(--color-neo-shadow);\n    background-color: var(--color-accent);\n  }\n\n  .neo-section-title {\n    font-family: 'Space Grotesk', sans-serif;\n    font-size: 5rem;\n    font-weight: 900;\n    line-height: 0.9;\n    text-transform: uppercase;\n    letter-spacing: -0.04em;\n  }\n\n  .neo-badge {\n    border: 2px solid var(--color-border);\n    background-color: var(--color-muted);\n    color: var(--color-foreground);\n    padding: 0.25rem 0.75rem;\n    font-size: 0.875rem;\n    font-weight: 700;\n    text-transform: uppercase;\n  }\n\n  .marquee-container {\n    overflow: hidden;\n    white-space: nowrap;\n    border-top: 3px solid var(--color-border);\n    border-bottom: 3px solid var(--color-border);\n    padding: 1.5rem 0;\n  }\n\n  .marquee-content {\n    display: inline-block;\n    animation: marquee 30s linear infinite;\n  }\n\n  .marquee-reverse {\n    animation: marquee-rev 30s linear infinite;\n  }\n\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  @keyframes marquee-rev {\n    0% { transform: translateX(-50%); }\n    100% { transform: translateX(0); }\n  }\n\n  .terminal-input {\n    background: transparent;\n    border: 3px solid var(--color-border);\n    padding: 1rem;\n    color: var(--color-foreground);\n    width: 100%;\n    font-family: 'Space Mono', monospace;\n    outline: none;\n  }\n\n  .terminal-input:focus {\n    border-color: var(--color-primary);\n    box-shadow: 4px 4px 0px 0px var(--color-primary);\n  }\n\n  /* Custom grid lines for the blueprint look */\n  .blueprint-bg {\n    background-image: \n      linear-gradient(var(--color-border) 1px, transparent 1px),\n      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);\n    background-size: 40px 40px;\n    background-color: var(--color-background);\n  }\n</style>\n\n<div class=\"blueprint-bg min-h-screen\" data-kid=\"1\">\n  \n  <nav class=\"sticky top-0 z-50 bg-[var(--color-background)] border-b-3 border-[var(--color-border)] px-8 py-4 flex justify-between items-center\" data-kid=\"2\">\n    <div class=\"font-heading text-2xl font-black uppercase tracking-tighter\" data-kid=\"3\">\n      MITZU<span class=\"text-[var(--color-primary)]\" data-kid=\"4\">.DEV</span>\n    </div>\n    <div class=\"hidden md:flex gap-8 font-bold text-sm uppercase\" data-kid=\"5\">\n      <a href=\"#services\" class=\"hover:text-[var(--color-primary)] transition-colors\" data-kid=\"6\">Services</a>\n      <a href=\"#projects\" class=\"hover:text-[var(--color-primary)] transition-colors\" data-kid=\"7\">Projects</a>\n      <a href=\"#skills\" class=\"hover:text-[var(--color-primary)] transition-colors\" data-kid=\"8\">Skills</a>\n      <a href=\"#contact\" class=\"hover:text-[var(--color-primary)] transition-colors\" data-kid=\"9\">Contact</a>\n    </div>\n    <div class=\"neo-badge\" data-kid=\"10\">v1.0.4_STABLE</div>\n  </nav>\n\n  \n  <section class=\"container mx-auto px-8 pt-24 pb-32 flex flex-col lg:flex-row gap-16 items-start\" data-kid=\"11\">\n    <div class=\"lg:w-7/12\" data-kid=\"12\">\n      <h1 class=\"neo-section-title mb-8\" data-kid=\"13\">\n        Architecting<br data-kid=\"14\">\n        <span class=\"text-[var(--color-primary)]\" data-kid=\"15\">Digital</span><br data-kid=\"16\">\n        Systems\n      </h1>\n      <p class=\"text-xl max-w-xl mb-12 leading-relaxed\" data-kid=\"17\">\n        Full-stack engineer specializing in high-performance web applications. \n        I build robust architectures using Neo-Brutalist constraints and modern tech stacks.\n        <span class=\"block mt-4 text-[var(--color-muted-foreground)] italic\" data-kid=\"18\">// CURRENT_STATUS: Accepting new contracts for Q3-Q4</span>\n      </p>\n      <button class=\"neo-button-primary text-xl\" data-kid=\"19\">\n        INITIALIZE_CONTACT()\n      </button>\n    </div>\n    \n    <div class=\"lg:w-5/12 relative mt-12 lg:mt-0\" data-kid=\"20\">\n      \n      <div class=\"absolute top-8 left-8 w-full aspect-square neo-card opacity-50 flex items-center justify-center p-12 -z-10 bg-[var(--color-muted)]\" data-kid=\"21\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/striped-sword.svg\" class=\"w-full h-full opacity-20\" style=\"filter: invert(1) sepia(1) saturate(5) hue-rotate(250deg);\" alt=\"Decorative Stripe Pattern\" decoding=\"async\" loading=\"lazy\" data-kid=\"22\">\n      </div>\n      \n      <div class=\"w-full aspect-square neo-card overflow-hidden group\" data-kid=\"23\">\n        <img src=\"https://images.unsplash.com/photo-1606780055009-a274a0608ad4?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500\" alt=\"Developer Portrait\" decoding=\"async\" loading=\"lazy\" data-kid=\"24\">\n        <div class=\"absolute bottom-6 right-6 neo-badge bg-[var(--color-primary)] text-white border-white\" data-kid=\"25\">\n          SYSTEM_ADMIN\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"services\" class=\"bg-[var(--color-card)] border-y-3 border-[var(--color-border)] py-32\" data-kid=\"26\">\n    <div class=\"container mx-auto px-8\" data-kid=\"27\">\n      <div class=\"mb-16\" data-kid=\"28\">\n        <div class=\"neo-badge mb-4\" data-kid=\"29\">Core_Capabilities</div>\n        <h2 class=\"font-heading text-4xl font-black uppercase\" data-kid=\"30\">Services.exe</h2>\n      </div>\n      \n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\" data-kid=\"31\">\n        \n        <div class=\"neo-card p-8 h-[450px] flex flex-col justify-between relative overflow-hidden\" data-kid=\"32\">\n          <i class=\"ti ti-terminal text-8xl text-[var(--color-border)] absolute -top-4 -right-4 opacity-50\" data-kid=\"33\"></i>\n          <div data-kid=\"34\">\n            <h3 class=\"font-heading text-2xl font-bold mb-4\" data-kid=\"35\">01 // Backend Architecture</h3>\n            <p class=\"text-[var(--color-muted-foreground)] leading-relaxed\" data-kid=\"36\">\n              Designing scalable server-side logic, database schemas, and robust API endpoints that handle millions of requests without breaking a sweat.\n            </p>\n          </div>\n          <div class=\"flex flex-wrap gap-2\" data-kid=\"37\">\n            <span class=\"neo-badge\" data-kid=\"38\">Node.js</span>\n            <span class=\"neo-badge\" data-kid=\"39\">PostgreSQL</span>\n            <span class=\"neo-badge\" data-kid=\"40\">Redis</span>\n          </div>\n        </div>\n\n        \n        <div class=\"neo-card p-8 h-[450px] flex flex-col justify-between relative overflow-hidden\" data-kid=\"41\">\n          <i class=\"ti ti-layout-template text-8xl text-[var(--color-border)] absolute -top-4 -right-4 opacity-50\" data-kid=\"42\"></i>\n          <div data-kid=\"43\">\n            <h3 class=\"font-heading text-2xl font-bold mb-4\" data-kid=\"44\">02 // Frontend Engineering</h3>\n            <p class=\"text-[var(--color-muted-foreground)] leading-relaxed\" data-kid=\"45\">\n              Crafting pixel-perfect, high-performance user interfaces with a focus on core web vitals and exceptional user experiences.\n            </p>\n          </div>\n          <div class=\"flex flex-wrap gap-2\" data-kid=\"46\">\n            <span class=\"neo-badge\" data-kid=\"47\">React</span>\n            <span class=\"neo-badge\" data-kid=\"48\">Next.js</span>\n            <span class=\"neo-badge\" data-kid=\"49\">Tailwind</span>\n          </div>\n        </div>\n\n        \n        <div class=\"neo-card p-8 h-[450px] flex flex-col justify-between relative overflow-hidden\" data-kid=\"50\">\n          <i class=\"ti ti-database text-8xl text-[var(--color-border)] absolute -top-4 -right-4 opacity-50\" data-kid=\"51\"></i>\n          <div data-kid=\"52\">\n            <h3 class=\"font-heading text-2xl font-bold mb-4\" data-kid=\"53\">03 // DevOps & Cloud</h3>\n            <p class=\"text-[var(--color-muted-foreground)] leading-relaxed\" data-kid=\"54\">\n              Automating deployment pipelines and managing cloud infrastructure to ensure your product is always online and ready to scale.\n            </p>\n          </div>\n          <div class=\"flex flex-wrap gap-2\" data-kid=\"55\">\n            <span class=\"neo-badge\" data-kid=\"56\">Docker</span>\n            <span class=\"neo-badge\" data-kid=\"57\">AWS</span>\n            <span class=\"neo-badge\" data-kid=\"58\">CI/CD</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"projects\" class=\"py-32 container mx-auto px-8\" data-kid=\"59\">\n    <div class=\"flex justify-between items-end mb-16\" data-kid=\"60\">\n      <div data-kid=\"61\">\n        <div class=\"neo-badge mb-4\" data-kid=\"62\">Verified_Artifacts</div>\n        <h2 class=\"font-heading text-4xl font-black uppercase\" data-kid=\"63\">Recent_Projects</h2>\n      </div>\n      <div class=\"text-right hidden md:block\" data-kid=\"64\">\n        <span class=\"text-xs uppercase opacity-50\" data-kid=\"65\">Scroll to explore</span>\n      </div>\n    </div>\n\n    <div class=\"space-y-32\" data-kid=\"66\">\n      \n      <div class=\"flex flex-col lg:flex-row gap-12 items-center\" data-kid=\"67\">\n        <div class=\"w-full lg:w-7/12\" data-kid=\"68\">\n          <div class=\"neo-card overflow-hidden aspect-video relative\" data-kid=\"69\">\n            <video src=\"https://videos.pexels.com/video-files/11274341/11274341-uhd_3840_2160_25fps.mp4\" poster=\"https://images.pexels.com/videos/11274341/code-css-html-javascript-11274341.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover\" data-kid=\"70\">\n            </video>\n            <div class=\"absolute top-4 left-4 neo-badge bg-[var(--color-primary)] text-white border-none font-black\" data-kid=\"71\">\n              PROJECT_ALPHA\n            </div>\n          </div>\n        </div>\n        <div class=\"w-full lg:w-5/12\" data-kid=\"72\">\n          <h3 class=\"font-heading text-3xl font-black mb-6\" data-kid=\"73\">NEO-COMMERCE ENGINE</h3>\n          <p class=\"mb-8 text-[var(--color-muted-foreground)] leading-relaxed\" data-kid=\"74\">\n            A high-speed e-commerce solution built for modular scale. Features real-time inventory tracking and a custom-built payment gateway integration.\n          </p>\n          <div class=\"flex flex-wrap gap-3 mb-8\" data-kid=\"75\">\n            <span class=\"neo-badge\" data-kid=\"76\">TypeScript</span>\n            <span class=\"neo-badge\" data-kid=\"77\">Prisma</span>\n            <span class=\"neo-badge\" data-kid=\"78\">Stripe</span>\n          </div>\n          <button class=\"neo-button-primary\" data-kid=\"79\">VIEW_REPO()</button>\n        </div>\n      </div>\n\n      \n      <div class=\"flex flex-col lg:flex-row-reverse gap-12 items-center\" data-kid=\"80\">\n        <div class=\"w-full lg:w-7/12\" data-kid=\"81\">\n          <div class=\"neo-card overflow-hidden aspect-video relative\" data-kid=\"82\">\n            <img src=\"https://images.unsplash.com/photo-1642132652860-471b4228023e?auto=format&w=1000&q=80&fit=crop\" class=\"w-full h-full object-cover\" alt=\"Project Mockup\" decoding=\"async\" loading=\"lazy\" data-kid=\"83\">\n            <div class=\"absolute top-4 right-4 neo-badge bg-[var(--color-primary)] text-white border-none font-black\" data-kid=\"84\">\n              PROJECT_BETA\n            </div>\n          </div>\n        </div>\n        <div class=\"w-full lg:w-5/12 text-right lg:text-left\" data-kid=\"85\">\n          <h3 class=\"font-heading text-3xl font-black mb-6\" data-kid=\"86\">QUANTUM_DASHBOARD</h3>\n          <p class=\"mb-8 text-[var(--color-muted-foreground)] leading-relaxed\" data-kid=\"87\">\n            Data visualization platform for real-time sensor monitoring. Implements complex SVG animations and WebSockets for sub-second updates.\n          </p>\n          <div class=\"flex flex-wrap justify-end lg:justify-start gap-3 mb-8\" data-kid=\"88\">\n            <span class=\"neo-badge\" data-kid=\"89\">D3.js</span>\n            <span class=\"neo-badge\" data-kid=\"90\">Socket.io</span>\n            <span class=\"neo-badge\" data-kid=\"91\">Next.js</span>\n          </div>\n          <button class=\"neo-button-primary\" data-kid=\"92\">VIEW_LIVE_DEMO()</button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"skills\" class=\"py-24 bg-[var(--color-muted)]\" data-kid=\"93\">\n    <div class=\"marquee-container mb-6 rotate-1\" data-kid=\"94\">\n      <div class=\"marquee-content flex gap-12 items-center\" data-kid=\"95\">\n        <span class=\"font-heading text-6xl font-black uppercase opacity-20\" data-kid=\"96\">REACT</span>\n        <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/purple-heart.svg\" class=\"w-12 h-12\" alt=\"Purple Heart\" data-kid=\"97\">\n        <span class=\"font-heading text-6xl font-black uppercase opacity-20\" data-kid=\"98\">NEXT.JS</span>\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/star-medal.svg\" class=\"w-12 h-12\" style=\"filter: invert(1) sepia(1) saturate(5) hue-rotate(250deg);\" alt=\"Star\" data-kid=\"99\">\n        <span class=\"font-heading text-6xl font-black uppercase opacity-20\" data-kid=\"100\">TYPESCRIPT</span>\n        <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/purple-heart.svg\" class=\"w-12 h-12\" alt=\"Purple Heart\" data-kid=\"101\">\n        <span class=\"font-heading text-6xl font-black uppercase opacity-20\" data-kid=\"102\">TAILWIND</span>\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/star-medal.svg\" class=\"w-12 h-12\" style=\"filter: invert(1) sepia(1) saturate(5) hue-rotate(250deg);\" alt=\"Star\" data-kid=\"103\">\n        \n        <span class=\"font-heading text-6xl font-black uppercase opacity-20\" data-kid=\"104\">REACT</span>\n        <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/purple-heart.svg\" class=\"w-12 h-12\" alt=\"Purple Heart\" data-kid=\"105\">\n        <span class=\"font-heading text-6xl font-black uppercase opacity-20\" data-kid=\"106\">NEXT.JS</span>\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/star-medal.svg\" class=\"w-12 h-12\" style=\"filter: invert(1) sepia(1) saturate(5) hue-rotate(250deg);\" alt=\"Star\" data-kid=\"107\">\n        <span class=\"font-heading text-6xl font-black uppercase opacity-20\" data-kid=\"108\">TYPESCRIPT</span>\n        <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/purple-heart.svg\" class=\"w-12 h-12\" alt=\"Purple Heart\" data-kid=\"109\">\n        <span class=\"font-heading text-6xl font-black uppercase opacity-20\" data-kid=\"110\">TAILWIND</span>\n      </div>\n    </div>\n\n    <div class=\"marquee-container -rotate-1 bg-[var(--color-primary)]\" data-kid=\"111\">\n      <div class=\"marquee-content marquee-reverse flex gap-12 items-center\" data-kid=\"112\">\n        <span class=\"font-heading text-6xl font-black uppercase text-white\" data-kid=\"113\">POSTGRESQL</span>\n        <i class=\"ti ti-database text-6xl text-white\" data-kid=\"114\"></i>\n        <span class=\"font-heading text-6xl font-black uppercase text-white\" data-kid=\"115\">NODE.JS</span>\n        <i class=\"ti ti-terminal text-6xl text-white\" data-kid=\"116\"></i>\n        <span class=\"font-heading text-6xl font-black uppercase text-white\" data-kid=\"117\">PRISMA</span>\n        <i class=\"ti ti-layout-template text-6xl text-white\" data-kid=\"118\"></i>\n        <span class=\"font-heading text-6xl font-black uppercase text-white\" data-kid=\"119\">AWS</span>\n        <i class=\"ti ti-cloud text-6xl text-white\" data-kid=\"120\"></i>\n        \n        <span class=\"font-heading text-6xl font-black uppercase text-white\" data-kid=\"121\">POSTGRESQL</span>\n        <i class=\"ti ti-database text-6xl text-white\" data-kid=\"122\"></i>\n        <span class=\"font-heading text-6xl font-black uppercase text-white\" data-kid=\"123\">NODE.JS</span>\n        <i class=\"ti ti-terminal text-6xl text-white\" data-kid=\"124\"></i>\n        <span class=\"font-heading text-6xl font-black uppercase text-white\" data-kid=\"125\">PRISMA</span>\n        <i class=\"ti ti-layout-template text-6xl text-white\" data-kid=\"126\"></i>\n        <span class=\"font-heading text-6xl font-black uppercase text-white\" data-kid=\"127\">AWS</span>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"contact\" class=\"py-32 container mx-auto px-8\" data-kid=\"128\">\n    <div class=\"max-w-4xl mx-auto\" data-kid=\"129\">\n      <div class=\"neo-card p-0 overflow-hidden neo-shadow-lg\" data-kid=\"130\">\n        \n        <div class=\"bg-[var(--color-border)] px-6 py-3 flex justify-between items-center\" data-kid=\"131\">\n          <div class=\"flex gap-2\" data-kid=\"132\">\n            <div class=\"w-3 h-3 rounded-full bg-red-500\" data-kid=\"133\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-yellow-500\" data-kid=\"134\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-green-500\" data-kid=\"135\"></div>\n          </div>\n          <div class=\"text-xs font-bold opacity-70\" data-kid=\"136\">terminal.exe — contact_form</div>\n          <div data-kid=\"137\"></div>\n        </div>\n        \n        <div class=\"p-12\" data-kid=\"138\">\n          <div class=\"mb-12\" data-kid=\"139\">\n            <h2 class=\"font-heading text-4xl font-black uppercase mb-4\" data-kid=\"140\">Initialize_Connection</h2>\n            <p class=\"text-[var(--color-muted-foreground)] uppercase text-xs font-bold tracking-widest\" data-kid=\"141\">\n              > Enter parameters to start the dialogue process.\n            </p>\n          </div>\n          \n          <form class=\"space-y-8\" data-kid=\"142\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"143\">\n              <div class=\"space-y-2\" data-kid=\"144\">\n                <label class=\"block text-xs font-black uppercase opacity-60\" data-kid=\"145\">NAME_STR</label>\n                <input type=\"text\" placeholder=\"YOUR NAME\" class=\"terminal-input\" data-kid=\"146\">\n              </div>\n              <div class=\"space-y-2\" data-kid=\"147\">\n                <label class=\"block text-xs font-black uppercase opacity-60\" data-kid=\"148\">EMAIL_ADDR</label>\n                <input type=\"email\" placeholder=\"YOUR@EMAIL.COM\" class=\"terminal-input\" data-kid=\"149\">\n              </div>\n            </div>\n            <div class=\"space-y-2\" data-kid=\"150\">\n              <label class=\"block text-xs font-black uppercase opacity-60\" data-kid=\"151\">MESSAGE_BODY</label>\n              <textarea placeholder=\"DESCRIBE YOUR PROJECT OR INQUIRY...\" rows=\"6\" class=\"terminal-input\" data-kid=\"152\"></textarea>\n            </div>\n            <button type=\"submit\" class=\"neo-button-primary w-full text-xl mt-4\" data-kid=\"153\">\n              EXECUTE_SEND()\n            </button>\n          </form>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"border-t-3 border-[var(--color-border)] py-12 bg-[var(--color-background)]\" data-kid=\"154\">\n    <div class=\"container mx-auto px-8 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"155\">\n      <div class=\"text-sm font-bold opacity-40\" data-kid=\"156\">\n        © 2026 MITZUSTUDIOS. ALL SYSTEMS OPERATIONAL.\n      </div>\n      <div class=\"flex gap-6\" data-kid=\"157\">\n        <a href=\"#\" class=\"neo-card p-2 hover:bg-[var(--color-primary)] hover:text-white transition-colors\" data-kid=\"158\">\n          <i class=\"ti ti-brand-github text-xl\" data-kid=\"159\"></i>\n        </a>\n        <a href=\"#\" class=\"neo-card p-2 hover:bg-[var(--color-primary)] hover:text-white transition-colors\" data-kid=\"160\">\n          <i class=\"ti ti-brand-linkedin text-xl\" data-kid=\"161\"></i>\n        </a>\n        <a href=\"#\" class=\"neo-card p-2 hover:bg-[var(--color-primary)] hover:text-white transition-colors\" data-kid=\"162\">\n          <i class=\"ti ti-brand-twitter text-xl\" data-kid=\"163\"></i>\n        </a>\n      </div>\n    </div>\n  </footer>\n</div>",
