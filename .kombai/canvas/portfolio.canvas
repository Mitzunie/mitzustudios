      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=JetBrains+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-background: #0a0a0f;\n    --color-foreground: #e8e0f0;\n    --color-card: #120e1a;\n    --color-primary: #7c3aed;\n    --color-secondary: #2d1b4e;\n    --color-muted: #1a1428;\n    --color-muted-foreground: #8a7a9e;\n    --color-accent: #6d28d9;\n    --color-border: #2d1b4e;\n    --color-neo-shadow: rgba(124, 58, 237, 0.3);\n  }\n\n  body {\n    background-color: var(--color-background);\n    color: var(--color-foreground);\n    font-family: 'JetBrains Mono', monospace;\n  }\n\n  .font-heading {\n    font-family: 'Archivo Black', sans-serif;\n  }\n\n  .text-stroke {\n    -webkit-text-stroke: 2px var(--color-primary);\n    color: transparent;\n    transition: all 0.3s ease;\n  }\n\n  .text-stroke:hover {\n    color: var(--color-primary);\n    text-shadow: 8px 8px 0px var(--color-neo-shadow);\n  }\n\n  /* Custom grid background */\n  .archival-grid {\n    background-image: \n      linear-gradient(var(--color-border) 1px, transparent 1px),\n      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);\n    background-size: 40px 40px;\n  }\n\n  .scanline {\n    width: 100%;\n    height: 100px;\n    z-index: 10;\n    background: linear-gradient(0deg, rgba(124, 58, 237, 0) 0%, rgba(124, 58, 237, 0.1) 50%, rgba(124, 58, 237, 0) 100%);\n    opacity: 0.1;\n    position: absolute;\n    bottom: 100%;\n    animation: scanline 8s linear infinite;\n  }\n\n  @keyframes scanline {\n    0% { bottom: 100%; }\n    100% { bottom: -100px; }\n  }\n\n  .redacted {\n    background-color: var(--color-foreground);\n    color: var(--color-foreground);\n  }\n\n  .blink {\n    animation: blink 1s step-end infinite;\n  }\n\n  @keyframes blink {\n    50% { opacity: 0; }\n  }\n</style>\n\n<div class=\"archival-grid min-h-screen relative overflow-hidden\" data-kid=\"1\">\n  <div class=\"scanline\" data-kid=\"2\"></div>\n\n  \n  <section class=\"grid grid-cols-1 md:grid-cols-2 min-h-screen border-b-4 border-[var(--color-border)]\" data-kid=\"3\">\n    \n    <div class=\"p-8 md:p-12 border-r-4 border-[var(--color-border)] flex flex-col justify-between\" data-kid=\"4\">\n      <div data-kid=\"5\">\n        <div class=\"flex items-center gap-3 mb-8\" data-kid=\"6\">\n          <div class=\"w-3 h-3 bg-[var(--color-primary)] rounded-full blink\" data-kid=\"7\"></div>\n          <span class=\"text-sm font-bold tracking-widest text-[var(--color-primary)] uppercase\" data-kid=\"8\">System_Status: Online</span>\n        </div>\n        <h1 class=\"font-heading text-6xl md:text-8xl leading-none mb-4 uppercase\" data-kid=\"9\">Mitzu<br data-kid=\"10\">Studios</h1>\n        <p class=\"text-[var(--color-muted-foreground)] max-w-md\" data-kid=\"11\">ARCHIVAL_RECORD_ID: MS_2026_06_21<br data-kid=\"12\">CLASS: WEB_DEVELOPMENT_UNIT</p>\n      </div>\n      <div class=\"mt-12\" data-kid=\"13\">\n        <div class=\"neo-badge inline-block mb-4 px-3 py-1 border-2 border-[var(--color-primary)] text-[var(--color-primary)]\" data-kid=\"14\">CORE_VERSION: v4.0.0</div>\n        <div class=\"text-4xl font-heading text-[var(--color-border)] opacity-30 select-none\" data-kid=\"15\">23.974.120.01</div>\n      </div>\n    </div>\n\n    \n    <div class=\"relative overflow-hidden border-b-4 md:border-b-0 border-[var(--color-border)]\" data-kid=\"16\">\n      <video src=\"https://videos.pexels.com/video-files/34342917/14549296_360_640_30fps.mp4\" poster=\"https://images.pexels.com/videos/34342917/pexels-photo-34342917.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=1200&w=630\" autoplay muted loop playsinline preload=\"metadata\" class=\"absolute inset-0 w-full h-full object-cover grayscale opacity-50 hover:grayscale-0 transition-all duration-700\" data-kid=\"17\"></video>\n      <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--color-background)] to-transparent pointer-events-none\" data-kid=\"18\"></div>\n      <div class=\"absolute top-4 right-4 text-xs font-bold text-[var(--color-primary)] p-2 bg-[var(--color-background)] border-2 border-[var(--color-primary)]\" data-kid=\"19\">\n        LIVE_RENDER: TOPOGRAPHIC_04\n      </div>\n    </div>\n\n    \n    <div class=\"p-8 md:p-12 border-t-4 md:border-t-0 border-r-4 border-[var(--color-border)] bg-[var(--color-muted)] flex flex-col justify-center\" data-kid=\"20\">\n      <div class=\"max-w-xl\" data-kid=\"21\">\n        <h2 class=\"text-xs font-bold text-[var(--color-primary)] mb-4 uppercase tracking-[0.3em]\" data-kid=\"22\">/// mission_statement</h2>\n        <p class=\"text-xl md:text-2xl leading-relaxed\" data-kid=\"23\">\n          Crafting high-performance digital architectures through rigid adherence to <span class=\"redacted\" data-kid=\"24\">performance</span> protocols and <span class=\"redacted\" data-kid=\"25\">pixel-perfect</span> execution. \n          Specializing in scalable full-stack environments.\n        </p>\n        <div class=\"mt-8 flex gap-4\" data-kid=\"26\">\n          <div class=\"w-12 h-1 bg-[var(--color-primary)]\" data-kid=\"27\"></div>\n          <div class=\"w-4 h-1 bg-[var(--color-primary)] opacity-50\" data-kid=\"28\"></div>\n          <div class=\"w-2 h-1 bg-[var(--color-primary)] opacity-25\" data-kid=\"29\"></div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"flex items-center justify-center p-0\" data-kid=\"30\">\n      <button class=\"w-full h-full group relative transition-all duration-300 hover:bg-[var(--color-primary)]\" data-kid=\"31\">\n        <div class=\"flex flex-col items-center justify-center gap-6\" data-kid=\"32\">\n          <span class=\"font-heading text-4xl md:text-6xl group-hover:text-white transition-colors\" data-kid=\"33\">INITIALIZE_COLLAB</span>\n          <i class=\"ti ti-chevron-right-square text-5xl group-hover:text-white group-hover:translate-x-4 transition-all\" data-kid=\"34\"></i>\n        </div>\n        <div class=\"absolute bottom-4 left-4 text-[10px] text-[var(--color-muted-foreground)] group-hover:text-white/50\" data-kid=\"35\">\n          SECURE_CONNECTION: AES_256_GCM\n        </div>\n      </button>\n    </div>\n  </section>\n\n  \n  <section class=\"p-8 md:p-20 border-b-4 border-[var(--color-border)]\" data-kid=\"36\">\n    <div class=\"mb-12\" data-kid=\"37\">\n      <h2 class=\"font-heading text-5xl uppercase mb-2\" data-kid=\"38\">Capabilities_Manifest</h2>\n      <div class=\"text-xs text-[var(--color-muted-foreground)]\" data-kid=\"39\">INDEX: 0042 // SERVICE_PROVISIONS</div>\n    </div>\n\n    <div class=\"overflow-x-auto\" data-kid=\"40\">\n      <table class=\"w-full border-collapse border-4 border-[var(--color-border)]\" data-kid=\"41\">\n        <thead data-kid=\"42\">\n          <tr class=\"bg-[var(--color-secondary)]\" data-kid=\"43\">\n            <th class=\"p-4 border-4 border-[var(--color-border)] text-left text-xs font-bold uppercase tracking-widest\" data-kid=\"44\">ID</th>\n            <th class=\"p-4 border-4 border-[var(--color-border)] text-left text-xs font-bold uppercase tracking-widest\" data-kid=\"45\">CAPABILITY</th>\n            <th class=\"p-4 border-4 border-[var(--color-border)] text-left text-xs font-bold uppercase tracking-widest\" data-kid=\"46\">RUNTIME_ENVIRONMENT</th>\n            <th class=\"p-4 border-4 border-[var(--color-border)] text-left text-xs font-bold uppercase tracking-widest\" data-kid=\"47\">SPECS</th>\n          </tr>\n        </thead>\n        <tbody class=\"text-sm\" data-kid=\"48\">\n          <tr class=\"hover:bg-[var(--color-muted)] transition-colors\" data-kid=\"49\">\n            <td class=\"p-4 border-4 border-[var(--color-border)] font-bold text-[var(--color-primary)]\" data-kid=\"50\">01</td>\n            <td class=\"p-4 border-4 border-[var(--color-border)] font-bold\" data-kid=\"51\">FRONTEND_SYSTEMS</td>\n            <td class=\"p-4 border-4 border-[var(--color-border)]\" data-kid=\"52\">NEXT_JS_CORE_V16</td>\n            <td class=\"p-4 border-4 border-[var(--color-border)]\" data-kid=\"53\">\n              <ul class=\"space-y-1\" data-kid=\"54\">\n                <li class=\"flex items-center gap-2\" data-kid=\"55\"><i class=\"ti ti-circle-check-filled text-[var(--color-primary)] text-xs\" data-kid=\"56\"></i> Tailwind CSS V4</li>\n                <li class=\"flex items-center gap-2\" data-kid=\"57\"><i class=\"ti ti-circle-check-filled text-[var(--color-primary)] text-xs\" data-kid=\"58\"></i> Framer Motion Architecture</li>\n              </ul>\n            </td>\n          </tr>\n          <tr class=\"hover:bg-[var(--color-muted)] transition-colors\" data-kid=\"59\">\n            <td class=\"p-4 border-4 border-[var(--color-border)] font-bold text-[var(--color-primary)]\" data-kid=\"60\">02</td>\n            <td class=\"p-4 border-4 border-[var(--color-border)] font-bold\" data-kid=\"61\">BACKEND_INFRASTRUCTURE</td>\n            <td class=\"p-4 border-4 border-[var(--color-border)]\" data-kid=\"62\">NODE_RUNTIME_LTS</td>\n            <td class=\"p-4 border-4 border-[var(--color-border)]\" data-kid=\"63\">\n              <ul class=\"space-y-1\" data-kid=\"64\">\n                <li class=\"flex items-center gap-2\" data-kid=\"65\"><i class=\"ti ti-circle-check-filled text-[var(--color-primary)] text-xs\" data-kid=\"66\"></i> PostgreSQL / Prisma ORM</li>\n                <li class=\"flex items-center gap-2\" data-kid=\"67\"><i class=\"ti ti-circle-check-filled text-[var(--color-primary)] text-xs\" data-kid=\"68\"></i> REST / GraphQL Pipelines</li>\n              </ul>\n            </td>\n          </tr>\n          <tr class=\"hover:bg-[var(--color-muted)] transition-colors\" data-kid=\"69\">\n            <td class=\"p-4 border-4 border-[var(--color-border)] font-bold text-[var(--color-primary)]\" data-kid=\"70\">03</td>\n            <td class=\"p-4 border-4 border-[var(--color-border)] font-bold\" data-kid=\"71\">UI_UX_DESIGN_PROTOCOLS</td>\n            <td class=\"p-4 border-4 border-[var(--color-border)]\" data-kid=\"72\">FIGMA_SYSTEM_INTEGRATION</td>\n            <td class=\"p-4 border-4 border-[var(--color-border)]\" data-kid=\"73\">\n              <ul class=\"space-y-1\" data-kid=\"74\">\n                <li class=\"flex items-center gap-2\" data-kid=\"75\"><i class=\"ti ti-circle-check-filled text-[var(--color-primary)] text-xs\" data-kid=\"76\"></i> Neo-Brutalist Visual Language</li>\n                <li class=\"flex items-center gap-2\" data-kid=\"77\"><i class=\"ti ti-circle-check-filled text-[var(--color-primary)] text-xs\" data-kid=\"78\"></i> Accessible Design Standards</li>\n              </ul>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  \n  <section class=\"grid grid-cols-1 md:grid-cols-4 border-b-4 border-[var(--color-border)] min-h-[600px]\" data-kid=\"79\">\n    \n    <div class=\"md:col-span-1 border-r-4 border-[var(--color-border)] p-6 bg-[var(--color-card)]\" data-kid=\"80\">\n      <h3 class=\"text-xs font-bold text-[var(--color-muted-foreground)] mb-6 uppercase tracking-widest flex items-center gap-2\" data-kid=\"81\">\n        <i class=\"ti ti-file-database\" data-kid=\"82\"></i> Explorer: Root/Projects\n      </h3>\n      <div class=\"space-y-2\" data-kid=\"83\">\n        <div class=\"p-3 bg-[var(--color-primary)] text-white font-bold cursor-pointer flex items-center justify-between group\" data-kid=\"84\">\n          <span data-kid=\"85\">PROJECT_ALPHA.EXE</span>\n          <span class=\"text-[8px] opacity-70\" data-kid=\"86\">V1.0.2</span>\n        </div>\n        <div class=\"p-3 border-2 border-[var(--color-border)] hover:border-[var(--color-primary)] cursor-pointer flex items-center justify-between group transition-colors\" data-kid=\"87\">\n          <span data-kid=\"88\">E_COMMERCE_CORE.ISO</span>\n          <span class=\"text-[8px] text-[var(--color-muted-foreground)]\" data-kid=\"89\">V2.4.0</span>\n        </div>\n        <div class=\"p-3 border-2 border-[var(--color-border)] hover:border-[var(--color-primary)] cursor-pointer flex items-center justify-between group transition-colors\" data-kid=\"90\">\n          <span data-kid=\"91\">DASHBOARD_V4.BIN</span>\n          <span class=\"text-[8px] text-[var(--color-muted-foreground)]\" data-kid=\"92\">V0.9.1</span>\n        </div>\n        <div class=\"p-3 border-2 border-[var(--color-border)] hover:border-[var(--color-primary)] cursor-pointer flex items-center justify-between group transition-colors\" data-kid=\"93\">\n          <span data-kid=\"94\">PORTFOLIO_V1.SRC</span>\n          <span class=\"text-[8px] text-[var(--color-muted-foreground)]\" data-kid=\"95\">V4.0.0</span>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"md:col-span-3 p-8 md:p-12 relative\" data-kid=\"96\">\n      <div class=\"neo-card h-full flex flex-col md:flex-row overflow-hidden border-4 border-[var(--color-border)]\" data-kid=\"97\">\n        <div class=\"md:w-1/2 relative min-h-[300px]\" data-kid=\"98\">\n          <img src=\"https://images.unsplash.com/photo-1560762484-813fc97650a0?auto=format&w=800&q=80&fit=crop\" alt=\"Project Preview\" class=\"absolute inset-0 w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500\" decoding=\"async\" loading=\"lazy\" data-kid=\"99\">\n          <div class=\"absolute inset-0 bg-[var(--color-primary)]/10 mix-blend-multiply\" data-kid=\"100\"></div>\n        </div>\n        <div class=\"md:w-1/2 p-8 flex flex-col justify-between bg-[var(--color-card)]\" data-kid=\"101\">\n          <div data-kid=\"102\">\n            <div class=\"flex gap-2 mb-4\" data-kid=\"103\">\n              <span class=\"neo-badge\" data-kid=\"104\">React</span>\n              <span class=\"neo-badge\" data-kid=\"105\">Next.js</span>\n              <span class=\"neo-badge\" data-kid=\"106\">Postgres</span>\n            </div>\n            <h4 class=\"font-heading text-4xl uppercase mb-4\" data-kid=\"107\">Project_Alpha_System</h4>\n            <p class=\"text-sm leading-relaxed text-[var(--color-muted-foreground)] mb-6\" data-kid=\"108\">\n              Full-scale automation platform for digital archival services. Implements real-time data streaming and secure distributed storage. \n              Reached 99.9% uptime during stress testing.\n            </p>\n          </div>\n          <div class=\"flex gap-4\" data-kid=\"109\">\n            <a href=\"#\" class=\"neo-button-primary px-6 py-2 text-sm flex items-center gap-2\" data-kid=\"110\">\n              <i class=\"ti ti-brand-github\" data-kid=\"111\"></i> VIEW_SRC\n            </a>\n            <a href=\"#\" class=\"border-2 border-[var(--color-border)] px-6 py-2 text-sm hover:bg-[var(--color-border)] transition-colors\" data-kid=\"112\">\n              LAUNCH_DEEP_LINK\n            </a>\n          </div>\n        </div>\n      </div>\n      <div class=\"absolute bottom-4 right-8 text-[8px] text-[var(--color-muted-foreground)]\" data-kid=\"113\">PREVIEW_ID: AX_9901_B</div>\n    </div>\n  </section>\n\n  \n  <section class=\"p-8 md:p-20 border-b-4 border-[var(--color-border)] bg-[var(--color-muted)]\" data-kid=\"114\">\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-20\" data-kid=\"115\">\n      <div data-kid=\"116\">\n        <h2 class=\"font-heading text-5xl uppercase mb-8\" data-kid=\"117\">System_Proficiency</h2>\n        <div class=\"space-y-8\" data-kid=\"118\">\n          \n          <div class=\"space-y-2\" data-kid=\"119\">\n            <div class=\"flex justify-between text-xs font-bold uppercase tracking-widest\" data-kid=\"120\">\n              <span data-kid=\"121\">TypeScript / JavaScript</span>\n              <span data-kid=\"122\">95%</span>\n            </div>\n            <div class=\"h-6 border-2 border-[var(--color-border)] relative flex items-center p-1 bg-[var(--color-background)]\" data-kid=\"123\">\n              <div class=\"h-full bg-[var(--color-primary)] neo-shadow-sm w-[95%] relative\" data-kid=\"124\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/square.svg\" class=\"absolute right-0 top-1/2 -translate-y-1/2 w-4 h-4 text-white opacity-50\" data-kid=\"125\">\n              </div>\n            </div>\n          </div>\n          <div class=\"space-y-2\" data-kid=\"126\">\n            <div class=\"flex justify-between text-xs font-bold uppercase tracking-widest\" data-kid=\"127\">\n              <span data-kid=\"128\">React / Next.js Framework</span>\n              <span data-kid=\"129\">90%</span>\n            </div>\n            <div class=\"h-6 border-2 border-[var(--color-border)] relative flex items-center p-1 bg-[var(--color-background)]\" data-kid=\"130\">\n              <div class=\"h-full bg-[var(--color-primary)] neo-shadow-sm w-[90%] relative\" data-kid=\"131\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/square.svg\" class=\"absolute right-0 top-1/2 -translate-y-1/2 w-4 h-4 text-white opacity-50\" data-kid=\"132\">\n              </div>\n            </div>\n          </div>\n          <div class=\"space-y-2\" data-kid=\"133\">\n            <div class=\"flex justify-between text-xs font-bold uppercase tracking-widest\" data-kid=\"134\">\n              <span data-kid=\"135\">Node.js / Express Architecture</span>\n              <span data-kid=\"136\">85%</span>\n            </div>\n            <div class=\"h-6 border-2 border-[var(--color-border)] relative flex items-center p-1 bg-[var(--color-background)]\" data-kid=\"137\">\n              <div class=\"h-full bg-[var(--color-primary)] neo-shadow-sm w-[85%] relative\" data-kid=\"138\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/square.svg\" class=\"absolute right-0 top-1/2 -translate-y-1/2 w-4 h-4 text-white opacity-50\" data-kid=\"139\">\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"flex flex-col justify-center border-l-4 border-[var(--color-border)] pl-12\" data-kid=\"140\">\n        <div class=\"text-[8rem] font-heading text-[var(--color-border)] opacity-20 select-none leading-none mb-4\" data-kid=\"141\">S_01</div>\n        <p class=\"text-sm text-[var(--color-muted-foreground)] uppercase tracking-widest max-w-xs\" data-kid=\"142\">\n          Continuous integration and delivery protocols applied to all development cycles. \n          Expertise in cloud infrastructure and database optimization.\n        </p>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"p-8 md:p-20\" data-kid=\"143\">\n    <div class=\"flex flex-col md:flex-row justify-between items-end gap-12\" data-kid=\"144\">\n      <div class=\"w-full\" data-kid=\"145\">\n        <div class=\"text-xs font-bold text-[var(--color-primary)] mb-6 uppercase tracking-[0.5em]\" data-kid=\"146\">/// initialization_complete</div>\n        <a href=\"mailto:hello@mitzustudios.web\" class=\"font-heading text-5xl md:text-8xl lg:text-[10rem] leading-none uppercase text-stroke block break-all\" data-kid=\"147\">\n          hello@mitzu<br data-kid=\"148\">studios.web\n        </a>\n      </div>\n      <div class=\"flex flex-col gap-4 min-w-[250px]\" data-kid=\"149\">\n        <div class=\"text-xs font-bold uppercase tracking-widest text-[var(--color-muted-foreground)]\" data-kid=\"150\">Social_Links:</div>\n        <div class=\"flex gap-2\" data-kid=\"151\">\n          <a href=\"#\" class=\"p-4 bg-[var(--color-secondary)] hover:bg-[var(--color-primary)] transition-all neo-shadow-sm border-2 border-[var(--color-border)] group\" data-kid=\"152\">\n            <i class=\"ti ti-brand-github text-2xl group-hover:scale-110 transition-transform\" data-kid=\"153\"></i>\n          </a>\n          <a href=\"#\" class=\"p-4 bg-[var(--color-secondary)] hover:bg-[var(--color-pr