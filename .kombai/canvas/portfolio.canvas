      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-background: #0a0a0f;\n    --color-foreground: #e8e0f0;\n    --color-card: #120e1a;\n    --color-primary: #7c3aed;\n    --color-secondary: #2d1b4e;\n    --color-muted: #1a1428;\n    --color-accent: #6d28d9;\n    --color-destructive: #dc2626;\n    --color-border: #2d1b4e;\n    --color-neo-shadow: rgba(124, 58, 237, 0.3);\n  }\n\n  body {\n    background-color: var(--color-background);\n    color: var(--color-foreground);\n    font-family: 'Inter', sans-serif;\n    overflow-x: hidden;\n  }\n\n  .font-heading {\n    font-family: 'Bebas Neue', sans-serif;\n  }\n\n  /* Custom scrollbar for project horizontal scroll */\n  .hide-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .hide-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n\n  .custom-scrollbar::-webkit-scrollbar {\n    height: 10px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-track {\n    background: var(--color-background);\n    border-top: 3px solid var(--color-border);\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    background: var(--color-primary);\n    border: 2px solid var(--color-border);\n  }\n\n  .diagonal-bg {\n    background: linear-gradient(165deg, var(--color-background) 50%, var(--color-muted) 50.1%);\n  }\n\n  /* Neo-Brutalist Utilities from globals.css */\n  .neo-border { border: 3px solid var(--color-border); }\n  .neo-shadow { box-shadow: 6px 6px 0px 0px var(--color-neo-shadow); }\n  .neo-shadow-lg { box-shadow: 8px 8px 0px 0px var(--color-neo-shadow); }\n  .neo-card {\n    border: 3px solid var(--color-border);\n    background: var(--color-card);\n    box-shadow: 6px 6px 0px 0px var(--color-neo-shadow);\n    transition: all 0.15s ease;\n  }\n  .neo-card:hover {\n    box-shadow: 8px 8px 0px 0px var(--color-primary);\n    transform: translate(-2px, -2px);\n  }\n  .neo-button {\n    border: 3px solid var(--color-border);\n    font-weight: 700;\n    text-transform: uppercase;\n    transition: all 0.15s ease;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0.75rem 1.5rem;\n  }\n  .neo-button:hover {\n    box-shadow: 4px 4px 0px 0px var(--color-neo-shadow);\n    transform: translate(-2px, -2px);\n  }\n  .neo-button-primary { background: var(--color-primary); color: white; }\n  .neo-badge {\n    border: 2px solid var(--color-border);\n    font-weight: 600;\n    font-size: 0.75rem;\n    padding: 0.25rem 0.5rem;\n    text-transform: uppercase;\n    background: var(--color-muted);\n  }\n</style>\n\n<div class=\"min-h-screen\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-0 w-full z-50 px-6 py-4 flex justify-between items-center mix-blend-difference\" data-kid=\"2\">\n    <div class=\"font-heading text-3xl tracking-wider text-[var(--color-primary)]\" data-kid=\"3\">MITZU.DEV</div>\n    <div class=\"hidden md:flex gap-8 font-heading text-xl\" data-kid=\"4\">\n      <a href=\"#services\" class=\"hover:text-[var(--color-primary)] transition-colors\" data-kid=\"5\">SERVICES</a>\n      <a href=\"#projects\" class=\"hover:text-[var(--color-primary)] transition-colors\" data-kid=\"6\">PROJECTS</a>\n      <a href=\"#skills\" class=\"hover:text-[var(--color-primary)] transition-colors\" data-kid=\"7\">SKILLS</a>\n      <a href=\"#contact\" class=\"hover:text-[var(--color-primary)] transition-colors\" data-kid=\"8\">CONTACT</a>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative pt-32 pb-20 px-6 min-h-[90vh] flex flex-col items-center justify-center overflow-hidden\" data-kid=\"9\">\n    \n    <div class=\"absolute top-1/4 left-10 w-24 h-24 neo-border rotate-12 opacity-20\" data-kid=\"10\"></div>\n    <div class=\"absolute bottom-1/4 right-10 w-40 h-40 neo-border -rotate-6 opacity-20\" data-kid=\"11\"></div>\n    \n    <div class=\"relative z-10 text-center max-w-5xl\" data-kid=\"12\">\n      <div class=\"flex flex-wrap justify-center gap-4 mb-8\" data-kid=\"13\">\n        <div class=\"neo-card px-8 py-4 -rotate-2 transform\" data-kid=\"14\">\n          <h1 class=\"font-heading text-6xl md:text-9xl leading-none\" data-kid=\"15\">BUILDING</h1>\n        </div>\n        <div class=\"neo-card px-8 py-4 rotate-3 transform bg-[var(--color-primary)] text-white\" data-kid=\"16\">\n          <h1 class=\"font-heading text-6xl md:text-9xl leading-none\" data-kid=\"17\">THE</h1>\n        </div>\n        <div class=\"neo-card px-8 py-4 -rotate-1 transform\" data-kid=\"18\">\n          <h1 class=\"font-heading text-6xl md:text-9xl leading-none\" data-kid=\"19\">WEB</h1>\n        </div>\n      </div>\n      \n      <p class=\"text-xl md:text-2xl max-w-2xl mx-auto mb-12 font-medium opacity-80 leading-relaxed\" data-kid=\"20\">\n        Web architecture for the bold. Crafting high-performance digital blueprints that defy the ordinary.\n      </p>\n\n      <div class=\"relative inline-block\" data-kid=\"21\">\n        <div class=\"absolute inset-0 bg-[var(--color-primary)] neo-border translate-x-1.5 translate-y-1.5\" data-kid=\"22\"></div>\n        <button class=\"neo-button neo-button-primary relative z-10 text-2xl px-12 py-5 font-heading tracking-widest\" data-kid=\"23\">\n          INITIALIZE PROJECT\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"absolute -bottom-10 -right-20 md:right-10 w-64 md:w-96 z-20 rotate-12\" data-kid=\"24\">\n      <div class=\"neo-card p-2 bg-white transform hover:rotate-0 transition-transform duration-500\" data-kid=\"25\">\n        <img src=\"https://images.unsplash.com/photo-1609217875667-af2ae7856077?auto=format&w=800&q=80&fit=crop\" alt=\"Hand holding glowing wire\" class=\"w-full grayscale hover:grayscale-0 transition-all\" loading=\"lazy\" decoding=\"async\" data-kid=\"26\">\n        <div class=\"absolute -top-4 -left-4\" data-kid=\"27\">\n          <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/alien-monster.svg\" class=\"w-16 h-16\" alt=\"Alien emoji\" data-kid=\"28\">\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"services\" class=\"py-24 px-6 bg-[var(--color-muted)] border-y-4 border-[var(--color-border)]\" data-kid=\"29\">\n    <div class=\"container-custom\" data-kid=\"30\">\n      <h2 class=\"font-heading text-7xl mb-16 inline-block bg-[var(--color-background)] neo-border px-6 py-2 -rotate-2\" data-kid=\"31\">\n        CAPABILITIES\n      </h2>\n      \n      <div class=\"space-y-[-3px]\" data-kid=\"32\">\n        \n        <div class=\"neo-border bg-[var(--color-background)] group cursor-pointer overflow-hidden\" data-kid=\"33\">\n          <div class=\"p-8 flex justify-between items-center\" data-kid=\"34\">\n            <div class=\"flex items-center gap-8\" data-kid=\"35\">\n              <span class=\"font-heading text-5xl opacity-30\" data-kid=\"36\">01</span>\n              <h3 class=\"font-heading text-4xl\" data-kid=\"37\">FRONTEND ARCHITECTURE</h3>\n            </div>\n            <i class=\"ti ti-crosshair text-4xl group-hover:rotate-90 transition-transform\" data-kid=\"38\"></i>\n          </div>\n          <div class=\"px-8 pb-8 flex flex-col md:flex-row gap-8 items-center\" data-kid=\"39\">\n            <p class=\"md:w-1/2 text-lg opacity-70\" data-kid=\"40\">\n              High-fidelity, responsive interfaces built with React and Next.js. I specialize in brutalist aesthetics and pixel-perfect implementation of complex layouts.\n            </p>\n            <div class=\"md:w-1/2 neo-card p-1\" data-kid=\"41\">\n              <img src=\"https://images.unsplash.com/photo-1760008486593-a85315610136?auto=format&w=600&q=80&fit=crop\" alt=\"Frontend Abstract\" class=\"w-full h-48 object-cover grayscale\" loading=\"lazy\" decoding=\"async\" data-kid=\"42\">\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"neo-border bg-[var(--color-background)] group cursor-pointer overflow-hidden\" data-kid=\"43\">\n          <div class=\"p-8 flex justify-between items-center opacity-50 hover:opacity-100 transition-opacity\" data-kid=\"44\">\n            <div class=\"flex items-center gap-8\" data-kid=\"45\">\n              <span class=\"font-heading text-5xl opacity-30\" data-kid=\"46\">02</span>\n              <h3 class=\"font-heading text-4xl\" data-kid=\"47\">BACKEND SYSTEMS</h3>\n            </div>\n            <i class=\"ti ti-zap text-4xl\" data-kid=\"48\"></i>\n          </div>\n        </div>\n\n        \n        <div class=\"neo-border bg-[var(--color-background)] group cursor-pointer overflow-hidden\" data-kid=\"49\">\n          <div class=\"p-8 flex justify-between items-center opacity-50 hover:opacity-100 transition-opacity\" data-kid=\"50\">\n            <div class=\"flex items-center gap-8\" data-kid=\"51\">\n              <span class=\"font-heading text-5xl opacity-30\" data-kid=\"52\">03</span>\n              <h3 class=\"font-heading text-4xl\" data-kid=\"53\">API DESIGN & INTEGRATION</h3>\n            </div>\n            <i class=\"ti ti-zap text-4xl\" data-kid=\"54\"></i>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"projects\" class=\"py-24 overflow-hidden\" data-kid=\"55\">\n    <div class=\"px-6 mb-12 flex justify-between items-end\" data-kid=\"56\">\n      <h2 class=\"font-heading text-8xl leading-none\" data-kid=\"57\">PROJECTS_V2</h2>\n      <p class=\"font-heading text-2xl opacity-50 mb-2\" data-kid=\"58\">[ SCROLL TO EXPLORE ]</p>\n    </div>\n    \n    <div class=\"flex gap-12 overflow-x-auto pb-12 px-12 custom-scrollbar\" data-kid=\"59\">\n      \n      <div class=\"flex-shrink-0 w-[400px]\" data-kid=\"60\">\n        <div class=\"neo-card p-6 h-[550px] flex flex-col\" data-kid=\"61\">\n          <div class=\"relative h-64 mb-6 neo-border overflow-hidden\" data-kid=\"62\">\n            <img src=\"https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&w=600&q=80&fit=crop\" alt=\"Dashboard Mockup\" class=\"w-full h-full object-cover\" loading=\"lazy\" decoding=\"async\" data-kid=\"63\">\n            <div class=\"absolute top-4 right-4 w-12 h-12 neo-border bg-[var(--color-background)] rounded-full flex items-center justify-center\" data-kid=\"64\">\n              <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/circle.svg\" class=\"w-8 h-8 invert opacity-50\" alt=\"Icon\" data-kid=\"65\">\n            </div>\n          </div>\n          <h3 class=\"font-heading text-4xl mb-4\" data-kid=\"66\">CYBER_ADMIN DASHBOARD</h3>\n          <p class=\"opacity-70 mb-6 flex-grow\" data-kid=\"67\">\n            A real-time data visualization platform for infrastructure monitoring. Built with Next.js and D3.js.\n          </p>\n          <div class=\"flex flex-wrap gap-2\" data-kid=\"68\">\n            <span class=\"neo-badge\" data-kid=\"69\">REACT</span>\n            <span class=\"neo-badge\" data-kid=\"70\">TYPESCRIPT</span>\n            <span class=\"neo-badge\" data-kid=\"71\">D3.JS</span>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"flex-shrink-0 w-[400px]\" data-kid=\"72\">\n        <div class=\"neo-card p-6 h-[550px] flex flex-col rotate-1 transform\" data-kid=\"73\">\n          <div class=\"relative h-64 mb-6 neo-border overflow-hidden\" data-kid=\"74\">\n            <img src=\"https://images.unsplash.com/photo-1619682508024-64c66726a373?auto=format&w=600&q=80&fit=crop\" alt=\"Code Abstract\" class=\"w-full h-full object-cover\" loading=\"lazy\" decoding=\"async\" data-kid=\"75\">\n            <div class=\"absolute top-4 right-4 w-12 h-12 neo-border bg-[var(--color-primary)] rounded-full flex items-center justify-center\" data-kid=\"76\">\n              <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/circle.svg\" class=\"w-8 h-8 invert\" alt=\"Icon\" data-kid=\"77\">\n            </div>\n          </div>\n          <h3 class=\"font-heading text-4xl mb-4\" data-kid=\"78\">NEO_SYNTAX THEME</h3>\n          <p class=\"opacity-70 mb-6 flex-grow\" data-kid=\"79\">\n            High-contrast VS Code theme designed for prolonged sessions. 100k+ downloads.\n          </p>\n          <div class=\"flex flex-wrap gap-2\" data-kid=\"80\">\n            <span class=\"neo-badge\" data-kid=\"81\">JSON</span>\n            <span class=\"neo-badge\" data-kid=\"82\">VSCODE</span>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"flex-shrink-0 w-[400px]\" data-kid=\"83\">\n        <div class=\"neo-card p-6 h-[550px] flex flex-col -rotate-1 transform\" data-kid=\"84\">\n          <div class=\"relative h-64 mb-6 neo-border overflow-hidden\" data-kid=\"85\">\n             <video src=\"https://videos.pexels.com/video-files/11274341/11274341-uhd_3840_2160_25fps.mp4\" poster=\"https://images.pexels.com/videos/11274341/code-css-html-javascript-11274341.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover\" data-kid=\"86\"></video>\n          </div>\n          <h3 class=\"font-heading text-4xl mb-4\" data-kid=\"87\">PROTOCOL_X</h3>\n          <p class=\"opacity-70 mb-6 flex-grow\" data-kid=\"88\">\n            Decentralized identity management system with biometric verification.\n          </p>\n          <div class=\"flex flex-wrap gap-2\" data-kid=\"89\">\n            <span class=\"neo-badge\" data-kid=\"90\">RUST</span>\n            <span class=\"neo-badge\" data-kid=\"91\">WASM</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"skills\" class=\"py-24 px-6 relative overflow-hidden\" data-kid=\"92\">\n    <div class=\"container-custom\" data-kid=\"93\">\n      <div class=\"neo-card w-full h-[600px] relative bg-[var(--color-card)] p-12 overflow-hidden\" data-kid=\"94\">\n        \n        <div class=\"absolute inset-0 opacity-10\" style=\"background-image: radial-gradient(var(--color-primary) 1.5px, transparent 1.5px); background-size: 30px 30px;\" data-kid=\"95\"></div>\n        \n        <h2 class=\"font-heading text-6xl relative z-10 mb-12\" data-kid=\"96\">TECH_STACK</h2>\n\n        \n        <div class=\"absolute top-[20%] left-[10%] neo-card bg-[var(--color-primary)] text-white px-8 py-3 -rotate-3 transform text-3xl font-heading\" data-kid=\"97\">NEXT.JS</div>\n        <div class=\"absolute top-[40%] left-[25%] neo-badge px-6 py-2 rotate-6 transform text-xl\" data-kid=\"98\">TAILWIND</div>\n        <div class=\"absolute bottom-[20%] left-[15%] neo-card px-10 py-4 -rotate-1 transform text-4xl font-heading\" data-kid=\"99\">TYPESCRIPT</div>\n        <div class=\"absolute top-[15%] right-[20%] neo-badge px-6 py-2 rotate-2 transform text-xl\" data-kid=\"100\">PRISMA</div>\n        <div class=\"absolute top-[50%] right-[30%] neo-card px-8 py-3 rotate-12 transform text-2xl font-heading\" data-kid=\"101\">POSTGRES</div>\n        <div class=\"absolute bottom-[30%] right-[10%] neo-card bg-[var(--color-accent)] text-white px-8 py-3 -rotate-6 transform text-3xl font-heading\" data-kid=\"102\">DOCKER</div>\n        <div class=\"absolute top-[60%] left-[40%] neo-badge px-4 py-1 -rotate-12 transform\" data-kid=\"103\">ZUSTAND</div>\n        <div class=\"absolute bottom-[10%] right-[40%] neo-badge px-8 py-2 rotate-3 transform text-lg\" data-kid=\"104\">TURBOREPO</div>\n        \n        \n        <div class=\"absolute top-10 right-10 w-20 h-20 opacity-20\" data-kid=\"105\">\n          <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/squib.svg\" class=\"w-full h-full invert\" alt=\"Dot grid shape\" data-kid=\"106\">\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"contact\" class=\"min-h-screen diagonal-bg py-32 px-6 flex items-center\" data-kid=\"107\">\n    <div class=\"container-custom grid md:grid-cols-2 gap-20 items-center\" data-kid=\"108\">\n      <div class=\"relative\" data-kid=\"109\">\n        <h2 class=\"font-heading text-[10rem] md:text-[14rem] leading-[0.8] mb-8\" data-kid=\"110\">LET'S<br data-kid=\"111\">TALK.</h2>\n        <div class=\"absolute -top-10 -right-10 md:right-0\" data-kid=\"112\">\n          <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/alien-monster.svg\" class=\"w-32 h-32 animate-bounce\" alt=\"Alien monster\" data-kid=\"113\">\n        </div>\n        <p class=\"text-2xl font-heading opacity-50 tracking-widest mt-12\" data-kid=\"114\">AVAILABLE FOR INITIALIZATION_2026</p>\n      </div>\n\n      <div class=\"neo-card p-10 bg-[var(--color-background)] rotate-1\" data-kid=\"115\">\n        <form class=\"space-y-6\" data-kid=\"116\">\n          <div data-kid=\"117\">\n            <label class=\"font-heading text-xl mb-2 block opacity-50\" data-kid=\"118\">INPUT_NAME</label>\n            <input type=\"text\" placeholder=\"WHO ARE YOU?\" class=\"w-full bg-[var(--color-muted)] neo-border p-4 text-xl outline-none focus:bg-[var(--color-card)] focus:shadow-[4px_4px_0px_0px_var(--color-primary)] transition-all\" data-kid=\"119\">\n          </div>\n          <div data-kid=\"120\">\n            <label class=\"font-heading text-xl mb-2 block opacity-50\" data-kid=\"121\">INPUT_EMAIL</label>\n            <input type=\"email\" placeholder=\"WHERE DO WE REPLY?\" class=\"w-full bg-[var(--color-muted)] neo-border p-4 text-xl outline-none focus:bg-[var(--color-card)] focus:shadow-[4px_4px_0px_0px_var(--color-primary)] transition-all\" data-kid=\"122\">\n          </div>\n          <div data-kid=\"123\">\n            <label class=\"font-heading text-xl mb-2 block opacity-50\" data-kid=\"124\">INPUT_MESSAGE</label>\n            <textarea rows=\"4\" placeholder=\"WHAT'S THE BLUEPRINT?\" class=\"w-full bg-[var(--color-muted)] neo-border p-4 text-xl outline-none focus:bg-[var(--color-card)] focus:shadow-[4px_4px_0px_0px_var(--color-primary)] transition-all resize-none\" data-kid=\"125\"></textarea>\n          </div>\n          \n          <button type=\"button\" class=\"w-full neo-button neo-button-primary py-5 text-2xl font-heading tracking-widest group\" data-kid=\"126\">\n            SEND_TRANSMISSION\n            <i class=\"ti ti-zap ml-4 group-hover:scale-125 transition-transform text-[var(--color-destructive)]\" data-kid=\"127\"></i>\n          </button>\n        </form>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-12 px-6 border-t-4 border-[var(--color-border)] text-center\" data-kid=\"128\">\n    <div class=\"font-heading text-2xl opacity-30 mb-4\" data-kid=\"129\">© 2026 MITZU STUDIOS // ALL RIGHTS RESERVED</div>\n    <div class=\"flex justify-center gap-6\" data-kid=\"130\">\n      <a href=\"#\" class=\"neo-badge hover:bg-[var(--color-primary)] hover:text-white transition-colors\" data-kid=\"131\">GH</a>\n      <a href=\"#\" class=\"neo-badge hover:bg-[var(--color-primary)] hover:text-white transition-colors\" data-kid=\"132\">LI</a>\n      <a href=\"#\" class=\"neo-badge hover:bg-[var(--color-primary)] hover:text-white transition-colors\" data-kid=\"133\">TW</a>\n    </div>\n  </footer>\n</div>",
