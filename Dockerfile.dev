# syntax=docker/dockerfile:1.7
# ─── MitzuStudios Portfolio — Dockerfile de Desarrollo ───
# Uso: docker build -f Dockerfile.dev -t mitzustudios-dev .
# O mejor: usa docker-compose.yml con servicios + pnpm dev directo.

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

# ───────── deps ─────────
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# ───────── dev ─────────
FROM base AS dev
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY . .

RUN addgroup -g 1001 -S nodejs && adduser -S mitzustudios -u 1001 -G nodejs
USER mitzustudios

EXPOSE 3000

CMD ["pnpm", "dev"]
